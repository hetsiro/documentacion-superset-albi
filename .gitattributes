# Normaliza el fin de línea automáticamente en el repo (LF interno)
* text=auto

# Archivos que se ejecutan en Linux/Docker: SIEMPRE con LF,
# aunque se clonen en Windows (evita el error $'\r' / "No such command 'init\r'"
# que rompe bash dentro del contenedor).
*.sh              text eol=lf
init-superset.sh  text eol=lf
Dockerfile*       text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
